# Copier en .env et renseigner les valeurs. Ne jamais commiter le .env réel.

# development | test | production — en production, le code OTP n'est jamais renvoyé dans la réponse
NODE_ENV=development

# Port HTTP (optionnel, défaut 3000)
PORT=3000

# CORS — origines autorisées séparées par des virgules. REQUIS en production ; '*' si vide hors production
CORS_ORIGINS=http://localhost:5173

# JWT — REQUIS en production (le démarrage échoue sans) ; repli sur un secret de dev sinon
JWT_SECRET=
# Durée de validité du token (format ms : 7d, 12h, 3600)
JWT_EXPIRES_IN=7d

# MySQL — REQUIS (dev/test/prod), vérifié au démarrage. DB_URL, si défini, remplace les DB_*
# (encoder les caractères spéciaux du mot de passe, ex. @ → %40) :
# DB_URL=mysql://user:password@host:3306/database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=amygo1

# Firebase FCM (Legacy API) — REQUIS en prod pour les push ; optionnel en dev/test
FIREBASE_SERVER_KEY=

# Twilio SMS — REQUIS en prod pour OTP/SMS ; optionnel en dev (OTP renvoyé dans la réponse si absent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps — optionnel partout (repli Haversine + 30 km/h si absent)
GOOGLE_MAPS_API_KEY=
